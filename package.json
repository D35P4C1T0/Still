{
  "name": "still-pomodoro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
