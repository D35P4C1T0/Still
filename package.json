    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "playwright-core": "^1.65.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
